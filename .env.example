# ─────────────────────────────────────────────────────────────
# EchoLedger — server environment
# Copy this file to .env at the repository root:
#   cp .env.example .env
# Never commit .env or a real API key.
# ─────────────────────────────────────────────────────────────

# Required for live transcription, claim extraction and comparison.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stable Gemini models. Both can be changed without touching code.
# Text reasoning / structured extraction / comparison:
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Speech transcription (word-level timestamps supported):
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Server port
PORT=8787

# Comma-separated browser origins allowed to call the API in development.
# In production the client is served by the same Express process.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Upload guardrails
MAX_AUDIO_MB=100
MAX_AUDIO_MINUTES=30

# Set to production when running the built app.
NODE_ENV=development
